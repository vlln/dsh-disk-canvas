{
  "name": "dsh-pancha",
  "version": "2.2.5",
  "type": "module",
  "description": "盘查 · 把磁盘变成一张可审查、可批注、可执行的盘面（dsh 插件）",
  "main": "./index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "lib/src",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "disk",
    "cleanup",
    "treemap",
    "annotation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/dsh-pancha.git"
  },
  "bugs": {
    "url": "https://github.com/vlln/dsh-pancha/issues"
  },
  "homepage": "https://github.com/vlln/dsh-pancha#readme"
}
